# Delicious Chicken Center - Production Environment Configuration

# Server Port (Render sets this automatically via process.env.PORT)
PORT=3000

# Admin Security Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_in_production
ADMIN_SECRET=change_this_admin_secret_key_in_production
ADMIN_SECRET_KEY=change_this_admin_secret_key_in_production
STRICT_ADMIN_AUTH=true

# ========================================================
# FIREBASE CLOUD FIRESTORE CREDENTIALS
# Choose ONE of the following options:
# ========================================================

# OPTION 1: Raw JSON string or Base64 string of serviceAccountKey.json (RECOMMENDED FOR RENDER)
# Paste the entire content of serviceAccountKey.json as a single line or base64:
FIREBASE_SERVICE_ACCOUNT_KEY=

# OPTION 2: Individual environment variables
# FIREBASE_PROJECT_ID=delicious-chicken-center
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@delicious-chicken-center.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OPTION 3: Path to local service account key file (for local development only, NEVER commit this file)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
